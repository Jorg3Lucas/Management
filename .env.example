# Senha do admin criado no primeiro boot (padrão: admin123 — troque depois em Usuários)
ADMIN_PASSWORD=admin123

# Token para sincronização automática via POST /api/sync (opcional)
SYNC_TOKEN=

# Máximo de páginas por servidor (100 jogadores por página; 10 = 1.000 jogadores)
SYNC_MAX_PAGES=10

# Pausa entre requisições ao fórum, em ms
SYNC_DELAY_MS=400

# Rodada diária automática de todos os servidores, no horário de Brasília (17 = 17h)
SYNC_DAILY_HOUR=17
# 0 desliga a rodada diária (útil em desenvolvimento)
SYNC_DAILY_ENABLED=1

# Fuso usado para exibir e interpretar datas
APP_TIMEZONE=Europe/Lisbon

# Caminho alternativo do banco SQLite
# DATABASE_PATH=./data/mir4.db
